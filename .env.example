# CrowdShield AI — environment configuration
# Copy this file to .env and adjust as needed. No paid APIs are required;
# the prototype runs fully offline/local.

# Backend
CROWDSHIELD_DB_PATH=backend/crowdshield.db
CROWDSHIELD_HOST=0.0.0.0
CROWDSHIELD_PORT=8000

# Frontend -> backend API base (used by frontend/app.js if window.CROWDSHIELD_API_BASE
# is not set inline; by default the frontend auto-detects http://<host>:8000)
CROWDSHIELD_API_BASE=http://localhost:8000

# Camera data directory (place camera_01.mp4 .. camera_05.mp4 here to enable the
# OpenCV motion-proxy pipeline; otherwise the app runs entirely in SIMULATION FALLBACK)
CAMERA_DATA_DIR=data/cameras
